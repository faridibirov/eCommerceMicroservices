{
  "profiles": {
    "http": {
        "commandName": "Project",
        "launchBrowser": true,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "MONGODB_HOST": "localhost",
        "MONGODB_PORT": "27017",
        "MONGODB_DATABASE": "OrdersDatabase",
        "UsersMicroserviceName": "localhost",
        "UsersMicroservicePort": "9090"
      },
        "dotnetRunMessages": true,
        "applicationUrl": "http://localhost:5153",
        "launchUrl": "swagger"
    },
    "https": {
        "commandName": "Project",
        "launchBrowser": true,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "MONGODB_HOST": "localhost",
        "MONGODB_PORT": "27017",
        "MONGODB_DATABASE": "OrdersDatabase",
        "UsersMicroserviceName": "localhost",
        "UsersMicroservicePort": "9090"
      },
        "dotnetRunMessages": true,
        "applicationUrl": "https://localhost:7075;http://localhost:5153",
        "launchUrl": "swagger"

    },
    "IIS Express": {
      "commandName": "IISExpress",
      "launchBrowser": true,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "MONGODB_DATABASE": "OrdersDatabase",
        "UsersMicroserviceName": "localhost",
        "UsersMicroservicePort": "9090"
      }
    },
    "Container (Dockerfile)": {
      "commandName": "Docker",
      "launchBrowser": true,
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}",
      "environmentVariables": {
        "ASPNETCORE_HTTPS_PORTS": "8081",
        "ASPNETCORE_HTTP_PORTS": "8080",
        "MONGODB_DATABASE": "OrdersDatabase",
        "UsersMicroserviceName": "localhost",
        "UsersMicroservicePort": "9090"
      },
      "publishAllPorts": true,
      "useSSL": true
    }
  },
  "$schema": "http://json.schemastore.org/launchsettings.json",
  "iisSettings": {
    "windowsAuthentication": false,
    "anonymousAuthentication": true,
    "iisExpress": {
      "applicationUrl": "http://localhost:14940",
      "sslPort": 44335
    }
  }
}